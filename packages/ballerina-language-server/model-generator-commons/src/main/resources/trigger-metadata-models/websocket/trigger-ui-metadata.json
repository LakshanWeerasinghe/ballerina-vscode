{
  "version": "v1.0",
  "metadata": {
    "kind": "listener"
  },
  "trigger": {
    "displayName": "WebSocket"
  },
  "listeners": [
    {
      "target": {
        "via": "l1",
        "id": "$listener"
      }
    }
  ],
  "serviceTypes": [
    {
      "target": {
        "via": "l1",
        "id": "$upgradeService"
      },
      "handlers": [
        {
          "target": {
            "via": "l1",
            "id": "$upgradeService.get"
          },
          "parameters": [
            {
              "target": {
                "via": "l1",
                "id": "$upgradeService.get.request"
              }
            }
          ],
          "returnType": {
            "target": {
              "via": "l1",
              "id": "$upgradeService.get.returns"
            }
          }
        }
      ]
    },
    {
      "target": {
        "via": "l1",
        "id": "$service"
      },
      "handlers": [
        {
          "target": {
            "via": "l1",
            "id": "$service.onOpen"
          },
          "parameters": [
            {
              "target": {
                "via": "l1",
                "id": "$service.onOpen.caller"
              }
            }
          ],
          "returnType": {
            "target": {
              "via": "l1",
              "id": "$service.onOpen.returns"
            }
          }
        },
        {
          "target": {
            "via": "l1",
            "id": "$service.onMessage"
          },
          "parameters": [
            {
              "target": {
                "via": "l1",
                "id": "$service.onMessage.caller"
              }
            },
            {
              "target": {
                "via": "l1",
                "id": "$service.onMessage.data"
              }
            }
          ],
          "returnType": {
            "target": {
              "via": "l1",
              "id": "$service.onMessage.returns"
            }
          }
        },
        {
          "target": {
            "via": "l1",
            "id": "$service.onTextMessage"
          },
          "parameters": [
            {
              "target": {
                "via": "l1",
                "id": "$service.onTextMessage.caller"
              }
            },
            {
              "target": {
                "via": "l1",
                "id": "$service.onTextMessage.text"
              }
            }
          ],
          "returnType": {
            "target": {
              "via": "l1",
              "id": "$service.onTextMessage.returns"
            }
          }
        },
        {
          "target": {
            "via": "l1",
            "id": "$service.onBinaryMessage"
          },
          "parameters": [
            {
              "target": {
                "via": "l1",
                "id": "$service.onBinaryMessage.caller"
              }
            },
            {
              "target": {
                "via": "l1",
                "id": "$service.onBinaryMessage.data"
              }
            }
          ],
          "returnType": {
            "target": {
              "via": "l1",
              "id": "$service.onBinaryMessage.returns"
            }
          }
        },
        {
          "target": {
            "via": "l1",
            "id": "$service.onPing"
          },
          "parameters": [
            {
              "target": {
                "via": "l1",
                "id": "$service.onPing.caller"
              }
            },
            {
              "target": {
                "via": "l1",
                "id": "$service.onPing.data"
              }
            }
          ],
          "returnType": {
            "target": {
              "via": "l1",
              "id": "$service.onPing.returns"
            }
          }
        },
        {
          "target": {
            "via": "l1",
            "id": "$service.onPong"
          },
          "parameters": [
            {
              "target": {
                "via": "l1",
                "id": "$service.onPong.caller"
              }
            },
            {
              "target": {
                "via": "l1",
                "id": "$service.onPong.data"
              }
            }
          ],
          "returnType": {
            "target": {
              "via": "l1",
              "id": "$service.onPong.returns"
            }
          }
        },
        {
          "target": {
            "via": "l1",
            "id": "$service.onIdleTimeout"
          },
          "parameters": [
            {
              "target": {
                "via": "l1",
                "id": "$service.onIdleTimeout.caller"
              }
            }
          ],
          "returnType": {
            "target": {
              "via": "l1",
              "id": "$service.onIdleTimeout.returns"
            }
          }
        },
        {
          "target": {
            "via": "l1",
            "id": "$service.onClose"
          },
          "parameters": [
            {
              "target": {
                "via": "l1",
                "id": "$service.onClose.caller"
              }
            },
            {
              "target": {
                "via": "l1",
                "id": "$service.onClose.statusCode"
              }
            },
            {
              "target": {
                "via": "l1",
                "id": "$service.onClose.reason"
              }
            }
          ],
          "returnType": {
            "target": {
              "via": "l1",
              "id": "$service.onClose.returns"
            }
          }
        },
        {
          "target": {
            "via": "l1",
            "id": "$service.onError"
          },
          "parameters": [
            {
              "target": {
                "via": "l1",
                "id": "$service.onError.caller"
              }
            },
            {
              "target": {
                "via": "l1",
                "id": "$service.onError.err"
              }
            }
          ],
          "returnType": {
            "target": {
              "via": "l1",
              "id": "$service.onError.returns"
            }
          }
        },
        {
          "target": {
            "via": "l1",
            "id": "$service.dispatched"
          },
          "parameters": [
            {
              "target": {
                "via": "l1",
                "id": "$service.dispatched.caller"
              }
            },
            {
              "target": {
                "via": "l1",
                "id": "$service.dispatched.message"
              }
            }
          ],
          "returnType": {
            "target": {
              "via": "l1",
              "id": "$service.dispatched.returns"
            }
          }
        },
        {
          "target": {
            "via": "l1",
            "id": "$service.dispatchedError"
          },
          "parameters": [
            {
              "target": {
                "via": "l1",
                "id": "$service.dispatchedError.caller"
              }
            },
            {
              "target": {
                "via": "l1",
                "id": "$service.dispatchedError.err"
              }
            }
          ],
          "returnType": {
            "target": {
              "via": "l1",
              "id": "$service.dispatchedError.returns"
            }
          }
        }
      ]
    }
  ]
}
