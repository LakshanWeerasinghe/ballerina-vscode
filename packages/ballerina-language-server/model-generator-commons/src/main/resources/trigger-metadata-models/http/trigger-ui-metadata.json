{
  "version": "v1.0",
  "metadata": {
    "kind": "listener"
  },
  "trigger": {
    "displayName": "HTTP"
  },
  "listeners": [
    {
      "target": {
        "via": "l1",
        "id": "$listener"
      }
    }
  ],
  "serviceTypes": [
    {
      "target": {
        "via": "l1",
        "id": "$service"
      },
      "handlers": [
        {
          "target": {
            "via": "l1",
            "id": "$service.resource"
          },
          "parameters": [
            {
              "target": {
                "via": "l1",
                "id": "$service.resource.caller"
              }
            },
            {
              "target": {
                "via": "l1",
                "id": "$service.resource.request"
              }
            },
            {
              "target": {
                "via": "l1",
                "id": "$service.resource.headers"
              }
            },
            {
              "target": {
                "via": "l1",
                "id": "$service.resource.payload"
              }
            },
            {
              "target": {
                "via": "l1",
                "id": "$service.resource.queryParam"
              }
            },
            {
              "target": {
                "via": "l1",
                "id": "$service.resource.headerParam"
              }
            }
          ],
          "returnType": {
            "target": {
              "via": "l1",
              "id": "$service.resource.returns"
            }
          }
        }
      ]
    }
  ]
}
