{
  "version": "v1.0",
  "metadata": {
    "kind": "listener"
  },
  "trigger": {
    "displayName": "GraphQL"
  },
  "listeners": [
    {
      "target": {
        "via": "l1",
        "id": "$listener"
      }
    }
  ],
  "serviceTypes": [
    {
      "target": {
        "via": "l1",
        "id": "$service"
      },
      "handlers": [
        {
          "target": {
            "via": "l1",
            "id": "$service.query"
          },
          "parameters": [
            {
              "target": {
                "via": "l1",
                "id": "$service.query.fieldArg"
              }
            }
          ],
          "returnType": {
            "target": {
              "via": "l1",
              "id": "$service.query.returns"
            }
          }
        },
        {
          "target": {
            "via": "l1",
            "id": "$service.mutation"
          },
          "parameters": [
            {
              "target": {
                "via": "l1",
                "id": "$service.mutation.fieldArg"
              }
            }
          ],
          "returnType": {
            "target": {
              "via": "l1",
              "id": "$service.mutation.returns"
            }
          }
        },
        {
          "target": {
            "via": "l1",
            "id": "$service.subscription"
          },
          "parameters": [
            {
              "target": {
                "via": "l1",
                "id": "$service.subscription.fieldArg"
              }
            }
          ],
          "returnType": {
            "target": {
              "via": "l1",
              "id": "$service.subscription.returns"
            }
          }
        }
      ]
    }
  ]
}
