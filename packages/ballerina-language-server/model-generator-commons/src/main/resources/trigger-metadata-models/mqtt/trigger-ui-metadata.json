            "source": {
              "codedata": {
                "type": "LISTENER_VAR_NAME"
              }
            }
          },
          "serverUri": {
            "key": "serverUri",
            "placeholder": "tcp://localhost:1883",
            "default": "\"tcp://localhost:1883\"",
