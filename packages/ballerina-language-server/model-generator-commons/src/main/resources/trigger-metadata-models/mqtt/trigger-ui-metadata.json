            "state": {
              "enabled": true,
              "editable": true,
              "optional": false,
              "advanced": false
            }
          },
          "subscriptions": {
            "key": "subscriptions",
            "placeholder": "mqtt/topic",
            "default": "\"mqtt/topic\"",
            "metadata": {
              "label": "Subscriptions",
              "description": "Topic(s) to subscribe to on the broker."
            },
            "widget": {
              "derived": false,
              "overrides": [
                { "widgetKind": "TEXT", "selected": true, "ballerinaType": "string" },
