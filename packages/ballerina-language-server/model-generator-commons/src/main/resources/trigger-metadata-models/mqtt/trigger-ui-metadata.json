          "section": {
            "label": "Configure MQTT Listener",
            "description": "Select an existing MQTT listener or create a new one"
          },
          "createNew": {
            "label": "Create new",
            "description": "Create a new MQTT listener"
          },
          "listenerConfig": {
            "label": "Listener Configurations",
            "description": "Configure the MQTT listener."
          },
          "useExisting": {
            "label": "Use existing",
            "description": "Select an existing MQTT listener"
          },
