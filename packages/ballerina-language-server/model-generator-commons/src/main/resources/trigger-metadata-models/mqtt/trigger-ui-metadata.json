            "state": {
              "enabled": true,
              "editable": true,
              "optional": false,
              "advanced": false
            }
          },
          "clientId": {
            "key": "clientId",
            "placeholder": "mqtt-listener-1",
            "default": "\"mqtt-listener-1\"",
            "metadata": {
              "label": "Client ID",
              "description": "A unique identifier to identify by the MQTT broker."
