                  "ballerinaType": "string[]",
                  "template": {
                    "metadata": { "label": "Topic" },
                    "enabled": false,
                    "editable": true,
                    "optional": false,
                    "advanced": false,
                    "types": [
                      { "fieldType": "TEXT", "ballerinaType": "string", "selected": true },
