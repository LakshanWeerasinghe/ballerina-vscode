{
  "version": "v1.0",
  "metadata": {
    "kind": "mcp"
  },
  "trigger": {
    "displayName": "MCP Service",
    "description": "Create a service that exposes tools to MCP clients.",
    "type": "mcp"
  },
  "readOnlyMetadata": [
    {
      "key": "basePath",
      "displayName": "Base Path",
      "extractor": "SERVICE_BASE_PATH"
    }
  ],
  "initForm": {
    "fields": [
      {
        "target": {
          "via": "semantic",
          "kind": "serviceAnnotationField",
          "serviceType": "$service",
          "annotation": "$serviceConfig",
          "path": "info.name"
        },
        "metadata": {
          "label": "Service Name",
          "description": "The name of the mcp service."
        },
        "field": {
          "key": "serviceName",
          "placeholder": "MCP Service",
          "default": "\"MCP Service\"",
          "source": {
            "codedata": {
              "type": "SERVICE_ANNOTATION",
              "path": "info.name",
              "moduleName": "mcp",
              "originalName": "ServiceConfig"
            }
          },
          "state": {
            "enabled": true,
            "editable": true,
            "optional": false,
            "advanced": false
          }
        },
        "source": {
          "codedata": {
            "type": "SERVICE_ANNOTATION",
            "path": "info.name",
            "moduleName": "mcp",
            "originalName": "ServiceConfig"
          }
        },
        "state": {
          "enabled": true,
          "editable": true,
          "optional": false,
          "advanced": false
        }
      },
      {
        "target": {
          "via": "semantic",
          "kind": "serviceAnnotationField",
          "serviceType": "$service",
          "annotation": "$serviceConfig",
          "path": "info.version"
        },
        "metadata": {
          "label": "Version",
          "description": "The version of the mcp service."
        },
        "field": {
          "key": "version",
          "placeholder": "1.0.0",
          "default": "\"1.0.0\"",
          "source": {
            "codedata": {
              "type": "SERVICE_ANNOTATION",
              "path": "info.version",
              "moduleName": "mcp",
              "originalName": "ServiceConfig"
            }
          },
          "state": {
            "enabled": true,
            "editable": true,
            "optional": false,
            "advanced": false
          }
        },
        "source": {
          "codedata": {
            "type": "SERVICE_ANNOTATION",
            "path": "info.version",
            "moduleName": "mcp",
            "originalName": "ServiceConfig"
          }
        },
        "state": {
          "enabled": true,
          "editable": true,
          "optional": false,
          "advanced": false
        }
      },
      {
        "target": {
          "via": "semantic",
          "kind": "recordField",
          "owner": "trigger.initProperties",
          "path": "serviceType"
        },
        "metadata": {
          "label": "Service Type",
          "description": "The MCP service type. mcp 1.0.3 offers only mcp:Service."
        },
        "state": {
          "hidden": true,
          "editable": false,
          "enabled": true,
          "optional": false,
          "advanced": false
        },
        "field": {
          "key": "serviceType",
          "default": "Service",
          "source": {
            "codedata": {
              "type": "SERVICE_TYPE_DESCRIPTOR"
            }
          },
          "state": {
            "enabled": true,
            "editable": false,
            "optional": false,
            "advanced": false,
            "hidden": true
          },
          "widget": {
            "derived": false,
            "overrides": [
              {
                "widgetKind": "SINGLE_SELECT",
                "selected": true,
                "ballerinaType": "mcp:Service",
                "options": [
                  {
                    "label": "MCP Service",
                    "value": "Service"
                  }
                ]
              }
            ]
          }
        },
        "source": {
          "codedata": {
            "type": "SERVICE_TYPE_DESCRIPTOR"
          }
        }
      },
      {
        "target": {
          "via": "l1",
          "id": "$listener2"
        },
        "metadata": {
          "label": "Port",
          "description": "The port on which the MCP service listens."
        },
        "state": {
          "enabled": true,
          "editable": true,
          "optional": false,
          "advanced": false
        },
        "field": {
          "key": "listenTo",
          "placeholder": "8080",
          "default": "8080",
          "metadata": {
            "label": "Port",
            "description": "The port on which the MCP service listens."
          },
          "widget": {
            "derived": false,
            "overrides": [
              {
                "widgetKind": "NUMBER",
                "selected": true,
                "ballerinaType": "int",
                "validations": [
                  {
                    "rule": "common.validate.port",
                    "severity": "WARNING",
                    "args": {
                      "min": 1,
                      "max": 65535
                    },
                    "message": "Port must be between {min} and {max}"
                  }
                ]
              },
              {
                "widgetKind": "EXPRESSION",
                "selected": false,
                "ballerinaType": "int"
              }
            ]
          },
          "validations": [
            {
              "rule": "common.validate.required"
            }
          ],
          "source": {
            "codedata": {
              "argType": "LISTENER_PARAM_REQUIRED",
              "position": 1,
              "originalName": "listenTo"
            }
          },
          "state": {
            "enabled": true,
            "editable": true,
            "optional": false,
            "advanced": false
          }
        }
      },
      {
        "target": {
          "via": "l1",
          "id": "$listener2"
        },
        "metadata": {
          "label": "Base Path",
          "description": "The base path of the MCP service"
        },
        "state": {
          "enabled": true,
          "editable": true,
          "optional": false,
          "advanced": false
        },
        "field": {
          "key": "basePath",
          "placeholder": "/mcp",
          "default": "/mcp",
          "metadata": {
            "label": "Base Path",
            "description": "The base path of the MCP service"
          },
          "widget": {
            "derived": false,
            "overrides": [
              {
                "widgetKind": "SERVICE_PATH",
                "selected": true,
                "ballerinaType": "string"
              }
            ]
          },
          "validations": [
            {
              "rule": "common.validate.required"
            }
          ],
          "source": {
            "codedata": {
              "type": "SERVICE_BASE_PATH"
            }
          },
          "state": {
            "enabled": true,
            "editable": true,
            "optional": false,
            "advanced": false
          }
        }
      },
      {
        "target": {
          "via": "l1",
          "id": "$listener2"
        },
        "metadata": {
          "label": "Listener Name",
          "description": "Provide a name for the listener being created"
        },
        "state": {
          "enabled": true,
          "editable": true,
          "optional": false,
          "advanced": true
        },
        "field": {
          "key": "listenerVarName",
          "default": "mcpListener",
          "metadata": {
            "label": "Listener Name",
            "description": "Provide a name for the listener being created"
          },
          "widget": {
            "derived": false,
            "overrides": [
              {
                "widgetKind": "IDENTIFIER",
                "selected": true,
                "ballerinaType": "mcp:Listener"
              }
            ]
          },
          "validations": [
            {
              "rule": "common.validate.identifier"
            },
            {
              "rule": "ls.validate.unique.listener.name",
              "message": "A listener with this name already exists in the project"
            }
          ],
          "source": {
            "codedata": {
              "type": "LISTENER_VAR_NAME"
            }
          },
          "state": {
            "enabled": true,
            "editable": true,
            "optional": false,
            "advanced": true
          }
        }
      }
    ]
  },
  "serviceTypes": [
    {
      "target": {
        "via": "l1",
        "id": "$service"
      },
      "metadata": {
        "label": "MCP Service",
        "description": "Handles MCP tool calls over the Streamable HTTP transport."
      },
      "state": {
        "editable": false,
        "enabled": true
      },
      "handlers": [
        {
          "target": {
            "via": "l1",
            "id": "$service.tool"
          },
          "metadata": {
            "label": "Tool",
            "description": "Define a tool function that MCP clients can discover and call.",
            "addLabel": "Add Tool"
          },
          "function": {
            "nameEditable": true,
            "nameMetadata": {
              "label": "Tool Name",
              "description": "The name of the MCP tool"
            },
            "repeatable": "TRUE",
            "canAddParameters": true,
            "documentation": {
              "metadata": {
                "label": "Tool Description",
                "description": "Description of what this MCP tool does"
              },
              "placeholder": "Describe what this tool does...",
              "editable": true
            }
          },
          "parameterSchema": [
            {
              "target": {
                "via": "semantic",
                "kind": "recordField",
                "owner": "newTool.parameterSchema",
                "path": "parameter"
              },
              "metadata": {
                "label": "Parameter",
                "description": "A parameter the tool call must (or may) supply."
              },
              "state": {
                "enabled": true,
                "editable": true,
                "optional": true
              }
            }
          ],
          "returnType": {
            "target": {
              "via": "l1",
              "id": "$service.tool.returns"
            },
            "metadata": {
              "label": "Return Type",
              "description": "The return type of the MCP tool"
            },
            "source": {
              "codedata": {
                "type": "FUNCTION_RETURN"
              }
            },
            "state": {
              "enabled": true,
              "editable": true,
              "optional": false
            }
          },
          "source": {
            "codedata": {
              "type": "FUNCTION",
              "moduleName": "mcp"
            }
          },
          "state": {
            "enabled": false,
            "editable": true,
            "optional": true
          }
        }
      ],
      "source": {
        "codedata": {
          "type": "SERVICE_TYPE_DESCRIPTOR",
          "moduleName": "mcp",
          "originalName": "Service"
        }
      }
    }
  ]
}
